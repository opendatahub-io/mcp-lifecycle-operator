FROM registry.access.redhat.com/ubi9/go-toolset@sha256:68d6b72cc3eb4c7975b2aca2451f6601c048c095d6b5fc2a310ce3df5ef2ada6 AS builder
ARG TARGETOS
ARG TARGETARCH
ARG TARGETPLATFORM

USER 0
WORKDIR /workspace
COPY . .

ENV GOEXPERIMENT=strictfipsruntime
ENV GOTOOLCHAIN=local
RUN make -f Makefile-ocp.mk build-ocp GO_BUILD_ENV="GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH}"

FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi9/ubi-minimal@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661 AS crypto-policy
RUN microdnf install -y crypto-policies-scripts && \
    update-crypto-policies --set DEFAULT:PQ --no-reload

FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi9/ubi-minimal@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661
COPY --from=crypto-policy /etc/crypto-policies /etc/crypto-policies
WORKDIR /
COPY --from=builder /workspace/manager .
RUN mkdir /licenses
COPY --from=builder /workspace/LICENSE /licenses/

USER 65532:65532

# Labels for enterprise contract
LABEL com.redhat.component=mcp-lifecycle-operator
LABEL cpe="cpe:/a:redhat:mcp_lifecycle_operator:0.1::el9"
LABEL description="MCP lifecycle operator"
LABEL io.k8s.description="MCP lifecycle operator"
LABEL io.k8s.display-name="MCP lifecycle operator"
LABEL io.openshift.tags="openshift,mcp,operator"
LABEL name="mcp-lifecycle-operator-beta/mcp-lifecycle-rhel9-operator"
LABEL release=0.1.0
LABEL url="https://github.com/opendatahub-io/mcp-lifecycle-operator"
LABEL vendor="Red Hat, Inc."
LABEL version=0.1.0
LABEL summary="MCP lifecycle operator"

ENTRYPOINT ["/manager"]
