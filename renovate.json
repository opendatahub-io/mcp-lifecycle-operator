{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>opendatahub-io/renovate-config",
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
  ],
  "commitMessagePrefix": "[{{baseBranch}}]",
  "ignorePaths": ["Dockerfile", "/docs/**"],
  "postUpdateOptions": ["gomodTidy"],
  "dockerfile": {
    "pinDigests": true,
    "includePaths": ["Dockerfile.konflux"]
  },
  "packageRules": [
    {
      "description": "Disable gomod on main — deps come from upstream",
      "matchManagers": ["gomod"],
      "matchBaseBranches": ["main"],
      "groupName": "Go module updates",
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile.konflux"],
      "automerge": true,
      "addLabels": ["jira/valid-reference", "lgtm", "approved"]
    }
  ]
}
