{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>opendatahub-io/renovate-config",
    "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
  ],
  "commitMessagePrefix": "[{{baseBranch}}]",
  "enabledManagers": ["dockerfile", "tekton", "rpm-lockfile"],
  "ignorePaths": ["/docs/**"],
  "dockerfile": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile.konflux"],
      "pinDigests": true
    },
    {
      "matchFileNames": ["Dockerfile"],
      "enabled": false
    }
  ]
}
