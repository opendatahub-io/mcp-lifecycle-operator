# Snyk (https://snyk.io) policy file
# ignores vulnerabilities in vendored dependencies
version: v1.25.0
exclude:
  code:
    - vendor/**
    # E2E test harness: shells out to gotestsum with an argv slice (no shell),
    # args are CI/developer-controlled. Snyk Code flags exec.Command as command
    # injection, which is a false positive for this non-shipped test tooling.
    - test/e2e/runner/**
    # The default E2E metrics endpoint uses controller-runtime's ephemeral
    # self-signed certificate. The test cannot retrieve that pod-local CA, so
    # it intentionally disables verification on a localhost port-forward.
    - test/e2e/manager_test.go
    # This file contains the explicitly user-selected insecureSkipVerify escape
    # hatch. It enforces TLS 1.2 and emits a Warning event before use; Snyk Code
    # has no line-level policy exclusion for this intentional API behavior.
    - internal/controller/mcpserver_controller_tls.go
